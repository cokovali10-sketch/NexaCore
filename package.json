{
  "name": "@nexa/core",
  "version": "0.5.0",
  "description": "NEXA Core — чип против лагов мирового уровня. WebGPU, 50k частиц, glTF+LOD, WASM-физика, профайлер, CLI.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": { "nexa": "./cli/nexa.js" },
  "scripts": {
    "demo": "npx vite serve demo --open",
    "build": "tsc --noEmit",
    "audit": "node cli/nexa.js optimize .",
    "init": "node cli/nexa.js init .",
    "scan": "node cli/nexa.js scan-three .",
    "migrate": "node cli/nexa.js migrate .",
    "test": "python tests/smoke.py",
    "bench": "node bench/physics.bench.mjs"
  },
  "keywords": ["performance", "webgl", "webgpu", "particles", "3d", "60fps", "engine"]
}
